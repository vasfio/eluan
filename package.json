{
  "name": "ragnar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @ragnar/core dev & pnpm --filter @ragnar/web dev",
    "build": "pnpm -r build",
    "build:tokens": "pnpm --filter @ragnar/tokens build",
    "build:core": "pnpm --filter @ragnar/core build",
    "build:web": "pnpm --filter @ragnar/web build",
    "build:native": "pnpm --filter @ragnar/native build",
    "lint": "pnpm -r lint",
    "storybook": "pnpm --filter @ragnar/core storybook",
    "storybook:web": "pnpm --filter @ragnar/web storybook"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0"
}
