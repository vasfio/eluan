{
  "name": "eluan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @eluan/core --filter @eluan/web dev",
    "build": "pnpm run build:publish",
    "build:publish": "pnpm --filter @eluan/tokens build && pnpm --filter @eluan/core build && pnpm --filter @eluan/web build",
    "build:tokens": "pnpm --filter @eluan/tokens build",
    "build:core": "pnpm --filter @eluan/core build",
    "build:web": "pnpm --filter @eluan/web build",
    "build:native": "pnpm --filter @eluan/native build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" exec tsc --noEmit -p tsconfig.build.json",
    "storybook": "pnpm --filter @eluan/core storybook",
    "storybook:web": "pnpm --filter @eluan/web storybook",
    "test": "pnpm -r --filter './packages/core' --filter './packages/web' --filter './packages/native' --filter './packages/theme-generator' run test",
    "test:coverage": "pnpm -r --filter './packages/core' --filter './packages/web' --filter './packages/native' run test:coverage",
    "build:storybook": "pnpm --filter @eluan/tokens build && pnpm --filter @eluan/core build && pnpm --filter @eluan/core build-storybook && pnpm --filter @eluan/web build-storybook && node scripts/assemble-storybook.mjs",
    "version-packages": "pnpm dlx @changesets/cli version",
    "release": "pnpm dlx @changesets/cli publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "human-id": "3.0.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "@xmldom/xmldom@<0.8.12": "0.8.13",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "fast-uri@<3.1.4": "^3.1.4",
      "form-data@>=3.0.0 <3.0.5": "^3.0.5",
      "js-yaml@3": "3.15.0",
      "js-yaml@4": "^4.3.0",
      "postcss@<8.5.10": "^8.5.10",
      "shell-quote@<1.8.4": "^1.8.4",
      "tar@<7.5.19": "^7.5.19",
      "undici@6": "^6.27.0",
      "uuid@<11.1.1": "^11.1.1",
      "ws@>=6.0.0 <6.2.4": "^6.2.4",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.20.1": "^8.20.1"
    }
  }
}
