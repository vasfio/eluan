{
  "name": "eluan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @eluan/core dev & pnpm --filter @eluan/web dev",
    "build": "pnpm run build:publish",
    "build:publish": "pnpm --filter @eluan/tokens build && pnpm --filter @eluan/core build && pnpm --filter @eluan/web build",
    "build:tokens": "pnpm --filter @eluan/tokens build",
    "build:core": "pnpm --filter @eluan/core build",
    "build:web": "pnpm --filter @eluan/web build",
    "build:native": "pnpm --filter @eluan/native build",
    "lint": "pnpm -r lint",
    "storybook": "pnpm --filter @eluan/core storybook",
    "storybook:web": "pnpm --filter @eluan/web storybook",
    "test": "pnpm -r --filter './packages/core' --filter './packages/web' --filter './packages/native' run test",
    "test:coverage": "pnpm -r --filter './packages/core' --filter './packages/web' --filter './packages/native' run test:coverage",
    "build:storybook": "pnpm --filter @eluan/tokens build && pnpm --filter @eluan/core build && pnpm --filter @eluan/core build-storybook && pnpm --filter @eluan/web build-storybook && node scripts/assemble-storybook.mjs",
    "version-packages": "pnpm dlx @changesets/cli version",
    "release": "pnpm dlx @changesets/cli publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "human-id": "3.0.1"
    }
  }
}
