{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@eluan/native": ["../../packages/native/src"],
      "@eluan/native/*": ["../../packages/native/src/*"],
      "@eluan/tokens": ["../../packages/tokens/src"],
      "@eluan/tokens/*": ["../../packages/tokens/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/native/src/**/*.ts",
    "../../packages/native/src/**/*.tsx"
  ]
}
