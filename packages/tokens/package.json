{
  "name": "@vasf/ragnar-tokens",
  "description": "Design tokens, CSS variables, themes, and fonts for the Ragnar design system",
  "version": "0.1.2",
  "license": "MIT",
  "homepage": "https://github.com/frolda/ragnar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frolda/ragnar.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/frolda/ragnar/issues"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "theme",
    "tailwindcss",
    "ragnar"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./fonts/all": "./dist/fonts.css",
    "./fonts/base": "./dist/fonts-base.css",
    "./fonts/industrial-retro": "./dist/fonts-industrial-retro.css",
    "./fonts/minimal": "./dist/fonts-minimal.css",
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/tokens.css src/primitives.css src/modes.css src/themes.css src/spacing.css src/curves.css src/fonts.css src/fonts-base.css src/fonts-industrial-retro.css src/fonts-minimal.css dist/",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8"
  }
}
