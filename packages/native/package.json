{
  "name": "@vasf/ragnar-native",
  "description": "React Native UI components sharing the Ragnar token system",
  "version": "0.1.1",
  "license": "MIT",
  "homepage": "https://github.com/frolda/ragnar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frolda/ragnar.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/frolda/ragnar/issues"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "design-system",
    "ragnar"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-native": ">=0.70.0 <0.80.0"
  },
  "dependencies": {
    "@vasf/ragnar-tokens": "workspace:^"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.1.0",
    "@storybook/addon-interactions": "^8.1.0",
    "@storybook/addon-links": "^8.1.0",
    "@storybook/blocks": "^8.1.0",
    "@storybook/react": "^8.1.0",
    "@storybook/react-vite": "^8.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.72.0",
    "@vitest/coverage-v8": "^4.0.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.19.12",
    "react-test-renderer": "^18.3.1",
    "storybook": "^8.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^4.0.18"
  }
}