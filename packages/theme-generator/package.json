{
  "name": "@eluan/theme-generator",
  "description": "CLI tool that generates accessible, light + dark mode Eluan theme token sets from accent colors",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Frolda",
  "homepage": "https://github.com/vasfio/eluan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasfio/eluan.git",
    "directory": "packages/theme-generator"
  },
  "bugs": {
    "url": "https://github.com/vasfio/eluan/issues"
  },
  "keywords": [
    "design-tokens",
    "theme",
    "cli",
    "eluan",
    "color"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eluan-theme": "./dist/cli/generate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint src --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "culori": "^4.0.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
